{
	"name": "yukabuki/cron-expression-explainer",
	"description": "Human-readable cron expressions (Fork with French translation)",
	"keywords": [
		"cron",
		"crontab",
		"frequency",
		"i18n",
		"internationalization",
		"interval",
		"l10n",
		"localization",
		"orisai",
		"recurring",
		"schedule",
		"scheduling",
		"scheduler",
		"task",
		"translation",
		"french"
	],
	"type": "library",
	"license": "MPL-2.0",
	"homepage": "https://gitlab.com/yukabuki/cron-expression-explainer",
	"authors": [
		{
			"name": "Yukabuki",
			"homepage": "https://gitlab.com/yukabuki"
		},
		{
			"name": "Marek Bartoš",
			"homepage": "https://github.com/mabar"
		}
	],
	"require": {
		"php": ">=8.0",
		"dragonmantank/cron-expression": "^3.3.0",
		"symfony/intl": "^5.4.35|^6.4.3|^7.0.3"
	},
	"require-dev": {
		"brianium/paratest": "^6.3.0",
		"infection/infection": "^0.26.0|^0.27.0|^0.28.0|^0.29.0",
		"nette/utils": "^3.1.0|^4.0.0",
		"orisai/coding-standard": "^3.0.0",
		"phpstan/extension-installer": "^1.0.0",
		"phpstan/phpstan": "^2.0.0",
		"phpstan/phpstan-deprecation-rules": "^2.0.0",
		"phpstan/phpstan-phpunit": "^2.0.0",
		"phpstan/phpstan-strict-rules": "^2.0.0",
		"phpunit/phpunit": "^9.5.0"
	},
	"autoload": {
		"psr-4": {
			"Yukabuki\\CronExpressionExplainer\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\Yukabuki\\CronExpressionExplainer\\": "tests"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"infection/extension-installer": true,
			"phpstan/extension-installer": true
		}
	}
}
